<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenAppPlugin</RootNamespace>
    <AssemblyName>OpenAppPlugin</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MacroDeck.Plugin.Analyzers" Version="3.0.0-preview.4" PrivateAssets="all" />
    <PackageReference Include="MacroDeck.Localization" Version="3.0.0-preview.4" />
    <PackageReference Include="MacroDeck.Plugin.Hosting" Version="3.0.0-preview.4" />
    <PackageReference Include="MacroDeck.Plugin.Serilog" Version="3.0.0-preview.4" />
    <PackageReference Include="MacroDeck.Sdk" Version="3.0.0-preview.4" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Localization\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
